# ============================================
# LLM 主模型配置
# ============================================

# 模型名称
LLM_MODEL=claude-sonnet-4-20250514

# 模型接口地址 (注意: 需要包含 /v1 路径)
# OpenAI 官方: https://api.openai.com/v1
# 阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# 本地模型: http://localhost:11434/v1
LLM_BASE_URL=https://api.anthropic.com/v1

# 模型接口请求的 API Key
LLM_API_KEY=your_api_key_here

# 模型接口请求方式: openai / anthropic
# 注意: 这决定使用哪种请求格式，不是供应商名称
# openai = 使用 OpenAI API 格式 (兼容 OpenAI, 阿里云, DeepSeek, 本地模型等)
# anthropic = 使用 Anthropic API 格式 (仅 Claude)
LLM_API_TYPE=anthropic

# 通用参数
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7


# ============================================
# 备用模型配置 (可选)
# 当主模型不可用时自动切换
# ============================================

# 备用模型1
BACKUP1_LLM_MODEL=gpt-4o
BACKUP1_LLM_BASE_URL=https://api.openai.com/v1
BACKUP1_LLM_API_KEY=your_openai_api_key_here
BACKUP1_LLM_API_TYPE=openai

# 备用模型2
BACKUP2_LLM_MODEL=deepseek-chat
BACKUP2_LLM_BASE_URL=https://api.deepseek.com/v1
BACKUP2_LLM_API_KEY=your_deepseek_api_key_here
BACKUP2_LLM_API_TYPE=openai

# 备用模型3
BACKUP3_LLM_MODEL=qwen-turbo
BACKUP3_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BACKUP3_LLM_API_KEY=your_aliyun_api_key_here
BACKUP3_LLM_API_TYPE=openai


# ============================================
# 其他配置
# ============================================

# 日志级别: debug / info / warning / error
LOG_LEVEL=info

# Agent配置
AGENT_NAME=cool-agent
AGENT_MAX_TURNS=50
